generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CatalogModel {
  id              String              @id @default(cuid())
  brand           String
  name            String
  series          String?
  year            Int?
  color           String?
  scale           String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           ItemInstance[]
  collectionItems CollectionItem[]
  suggestionsApproved CatalogSuggestion[] @relation("SuggestionApproval")
  photos          CatalogModelPhoto[]
  sellerSubmissions SellerSubmission[]

  @@index([brand])
  @@index([name])
}

model CatalogModelMergeAudit {
  id                      String   @id @default(cuid())
  // Stored as plain strings — not FK relations — so audit survives duplicate deletion.
  canonicalCatalogModelId String
  duplicateCatalogModelId String
  canonicalSnapshot       Json
  duplicateSnapshot       Json
  movedItemInstances      Int      @default(0)
  movedCollectionItems    Int      @default(0)
  movedSellerSubmissions  Int      @default(0)
  movedCatalogSuggestions Int      @default(0)
  movedPhotos             Int      @default(0)
  adminNote               String?
  mergedAt                DateTime @default(now())

  @@index([canonicalCatalogModelId])
  @@index([duplicateCatalogModelId])
}

model CatalogDuplicateSuppression {
  id        String   @id @default(cuid())
  // Stable pair key: smaller id + "|" + larger id (lexicographic). Unique per pair.
  pairKey   String   @unique
  adminNote String?
  createdAt DateTime @default(now())
}

model CatalogModelPhoto {
  id        String       @id @default(cuid())
  catalogId String
  catalog   CatalogModel @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ItemInstance {
  id                String           @id @default(cuid())
  sku               String           @unique
  catalogId         String
  catalog           CatalogModel     @relation(fields: [catalogId], references: [id])
  locationId        String?
  location          StorageLocation? @relation(fields: [locationId], references: [id])
  cardedOrLoose     String
  condition         String
  conditionNotes    String?
  purchasePrice     Float?
  listPrice         Float?
  status            String           @default("draft")
  notes             String?
  sourceType        String?
  sellerAgreementId String?
  sellerAgreement   SellerAgreement? @relation(fields: [sellerAgreementId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  photos            Photo[]
  listing           Listing?
  orderItems        OrderItem[]
  intakeDraft       IntakeDraft?

  @@index([sellerAgreementId])
  @@index([sourceType])
}

model Photo {
  id        String       @id @default(cuid())
  itemId    String
  item      ItemInstance @relation(fields: [itemId], references: [id])
  url       String
  type      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
}

model StorageLocation {
  id        String         @id @default(cuid())
  label     String
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     ItemInstance[]
}

model Listing {
  id          String       @id @default(cuid())
  itemId      String       @unique
  item        ItemInstance @relation(fields: [itemId], references: [id])
  price       Float
  title       String
  description String?
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
}

model CustomerProfile {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  phone           String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  orders              Order[]
  sessions            CustomerSession[]
  sellerProfile       SellerProfile?
  collectionItems     CollectionItem[]
  catalogSuggestions  CatalogSuggestion[]
  sellerSubmissions   SellerSubmission[]
  sellerPayoutLines   SellerPayoutLine[]
  sellerPayouts       SellerPayout[]
}

model SellerProfile {
  id             String          @id @default(cuid())
  profileId      String          @unique
  profile        CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  displayName    String?
  status         String          @default("pending")
  commissionRate Float           @default(0.20)
  payoutMethod   String?
  payoutHandle   String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  agreements     SellerAgreement[]
  payouts        SellerPayout[]
}

model CustomerLoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CustomerSession {
  id          String          @id @default(cuid())
  profileId   String
  sessionHash String          @unique
  expiresAt   DateTime
  createdAt   DateTime        @default(now())

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
}

model Order {
  id                 String           @id @default(cuid())
  buyerName          String
  buyerEmail         String
  buyerPhone         String?
  status             String           @default("pending")
  notes              String?
  estimatedShipping  Float?
  adminNotes         String?
  followUpNotes      String?
  paymentStatus      String           @default("unpaid")
  paymentMethod      String?
  paymentReference   String?
  paymentLink        String?
  paymentRequestedAt     DateTime?
  paidAt                 DateTime?
  completedAt            DateTime?
  stripeSessionId        String?
  stripeSessionExpiresAt DateTime?
  stripePaymentIntentId  String?
  customerProfileId      String?
  customerProfile        CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  orderItems             OrderItem[]
}

model OrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  itemId    String
  item      ItemInstance @relation(fields: [itemId], references: [id])
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id])
  price     Float
  createdAt DateTime     @default(now())

  sellerPayoutLine SellerPayoutLine?
}

model CollectionItem {
  id             String               @id @default(cuid())
  profileId      String
  profile        CustomerProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  catalogId      String?
  catalog        CatalogModel?        @relation(fields: [catalogId], references: [id])

  brand          String?
  name           String?
  series         String?
  year           Int?
  color          String?
  scale          String?
  cardedOrLoose  String?
  condition      String?
  conditionNotes String?
  quantity       Int                  @default(1)

  purchasePrice  Float?
  purchaseDate   DateTime?
  notes          String?

  aiExtractionConfidence Float?
  aiExtractionNotes      String?
  aiExtractedAt          DateTime?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  photos             CollectionItemPhoto[]
  catalogSuggestions CatalogSuggestion[]
  sellerSubmissions  SellerSubmission[]
}

model CollectionItemPhoto {
  id        String         @id @default(cuid())
  itemId    String
  item      CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  url       String
  type      String         @default("other")
  sortOrder Int            @default(0)

  createdAt DateTime       @default(now())
}

model CatalogSuggestion {
  id        String          @id @default(cuid())

  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  collectionItemId String?
  collectionItem   CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)

  brand  String
  name   String
  series String?
  year   Int?
  color  String?
  scale  String?

  userNotes  String?
  adminNotes String?

  aiExtractionConfidence Float?

  status String @default("pending")

  reviewedAt        DateTime?
  approvedCatalogId String?
  approvedCatalog   CatalogModel? @relation("SuggestionApproval", fields: [approvedCatalogId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerSubmission {
  id        String          @id @default(cuid())
  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  collectionItemId String?
  collectionItem   CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)

  catalogId String?
  catalog   CatalogModel? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  brand          String?
  name           String?
  series         String?
  year           Int?
  color          String?
  scale          String?
  cardedOrLoose  String?
  condition      String?
  conditionNotes String?
  quantity       Int       @default(1)

  saleTypePreference String?
  expectedPrice      Float?
  userNotes          String?

  userMessage String?
  adminNotes  String?

  status     String    @default("submitted")
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       SellerSubmissionPhoto[]
  intakeDrafts IntakeDraft[]
  agreements   SellerAgreement[]

  lifecycleEvents   SellerLifecycleEvent[]
  lifecycleCases    SellerLifecycleCase[]
  pricingPreference SellerPricingPreference?

  @@index([profileId])
  @@index([status])
  @@index([collectionItemId])
}

model SellerSubmissionPhoto {
  id           String           @id @default(cuid())
  submissionId String
  submission   SellerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
}

model IntakeDraft {
  id              String @id @default(cuid())
  status          String @default("draft")

  frontPhotoUrl   String?
  backPhotoUrl    String?

  brand           String?
  name            String?
  year            Int?
  series          String?
  color           String?
  scale           String?
  cardedOrLoose   String?
  condition       String?
  conditionNotes  String?
  listPrice       Float?
  storageLocation String?
  notes           String?

  convertedItemId String?       @unique
  convertedItem   ItemInstance? @relation(fields: [convertedItemId], references: [id])

  aiExtractionRaw        String?
  aiExtractionNotes      String?
  aiExtractionConfidence Float?

  sellerSubmissionId String?
  sellerSubmission   SellerSubmission? @relation(fields: [sellerSubmissionId], references: [id], onDelete: SetNull)

  rejectedAt            DateTime?
  rejectionReason       String?
  sellerRejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerSubmissionId])
}

model SellerAgreement {
  id           String           @id @default(cuid())
  submissionId String
  submission   SellerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  sellerProfileId String?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)

  type     String
  currency String @default("USD")
  status   String @default("draft")

  agreedBuyoutAmount  Decimal? @db.Decimal(10, 2)
  commissionPercent   Decimal? @db.Decimal(6, 4)
  fixedFee            Decimal? @db.Decimal(10, 2)
  minimumSellerPayout Decimal? @db.Decimal(10, 2)
  agreedListPrice     Decimal? @db.Decimal(10, 2)

  sellerTermsSummary String?
  adminNotes         String?

  items        ItemInstance[]
  payoutLines  SellerPayoutLine[]

  proposedAt       DateTime?
  acceptedAt       DateTime?
  acceptanceMethod String?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([sellerProfileId])
  @@index([status])
}

model SellerPayoutLine {
  id        String @id @default(cuid())
  sourceKey String @unique

  lineType String
  status   String @default("eligible")
  currency String @default("USD")

  customerProfileId String
  customerProfile   CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)

  agreementId String?
  agreement   SellerAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  orderItemId String?  @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  payoutId String?
  payout   SellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  grossSalePrice      Decimal? @db.Decimal(10, 2)
  agreedBuyoutAmount  Decimal? @db.Decimal(10, 2)

  commissionPercent   Decimal? @db.Decimal(6, 4)
  commissionAmount    Decimal? @db.Decimal(10, 2)
  fixedFee            Decimal? @db.Decimal(10, 2)
  minimumSellerPayout Decimal? @db.Decimal(10, 2)
  minimumAdjustment   Decimal? @db.Decimal(10, 2)

  netAmount  Decimal  @db.Decimal(10, 2)
  eligibleAt DateTime

  heldAt     DateTime?
  holdReason String?

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerProfileId])
  @@index([agreementId])
  @@index([payoutId])
  @@index([status])
  @@index([lineType])
}

model SellerPayout {
  id       String @id @default(cuid())
  status   String @default("draft")
  currency String @default("USD")

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)

  sellerProfileId String?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)

  totalAmount Decimal @db.Decimal(10, 2)

  approvedAt DateTime?
  paidAt     DateTime?

  paymentMethod    String?
  paymentReference String?
  adminNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SellerPayoutLine[]

  @@index([customerProfileId])
  @@index([sellerProfileId])
  @@index([status])
}

model SellerLifecycleEvent {
  id                 String           @id @default(cuid())
  eventKey           String           @unique
  sellerSubmissionId String
  sellerSubmission   SellerSubmission @relation(fields: [sellerSubmissionId], references: [id], onDelete: Restrict)
  eventType          String
  sourceEntityType   String?
  sourceEntityId     String?
  sellerVisible      Boolean          @default(false)
  sellerTitle        String?
  sellerDescription  String?
  adminDescription   String?
  metadata           Json?
  occurredAt         DateTime
  createdAt          DateTime         @default(now())

  @@index([sellerSubmissionId])
  @@index([eventType])
  @@index([sourceEntityType, sourceEntityId])
  @@index([occurredAt])
}

model SellerLifecycleCase {
  id                 String           @id @default(cuid())
  sellerSubmissionId String
  sellerSubmission   SellerSubmission @relation(fields: [sellerSubmissionId], references: [id], onDelete: Restrict)
  caseType           String
  status             String           @default("open")
  agreementId        String?
  intakeDraftId      String?
  itemInstanceId     String?
  listingId          String?
  orderId            String?
  orderItemId        String?
  sellerPayoutLineId String?
  sellerVisible      Boolean          @default(false)
  sellerMessage      String?
  adminNotes         String?
  resolutionSummary  String?
  openedAt           DateTime         @default(now())
  resolvedAt         DateTime?
  cancelledAt        DateTime?
  returnCarrier        String?
  returnTrackingNumber String?
  returnShippedAt      DateTime?
  returnedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([sellerSubmissionId])
  @@index([caseType])
  @@index([status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([itemInstanceId])
  @@index([sellerPayoutLineId])
}

model SellerPricingPreference {
  id                      String           @id @default(cuid())
  sellerSubmissionId      String           @unique
  sellerSubmission        SellerSubmission @relation(fields: [sellerSubmissionId], references: [id], onDelete: Cascade)

  strategy                String
  selectedTargetPrice     Decimal          @db.Decimal(10, 2)
  customDesiredPrice      Decimal?         @db.Decimal(10, 2)
  suggestedFastPrice      Decimal?         @db.Decimal(10, 2)
  suggestedMaxPrice       Decimal?         @db.Decimal(10, 2)
  estimatedDaysToSell     Int?
  estimatedSellerProceeds Decimal?         @db.Decimal(10, 2)
  confidence              String
  matchLevel              String
  comparableCount         Int
  capturedAt              DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
