// 19B: anonymous seller capture session — deliberately a SEPARATE model from
// MobileCaptureSession, not a nullable-customerProfileId variant of it. Every
// existing MobileCapture ownership query is scoped by customerProfileId; making
// that nullable would force every one of those queries (and the 18A-18D
// CatalogModel-merge reconciliation logic, which reasons about "the customer
// actively editing this session") to branch on guest-vs-authenticated. Keeping
// guest state in its own table means the authenticated invariants are never
// touched, and 19C's future claim step is a well-defined conversion into
// MobileCaptureSession/Item rather than a permanent merger of two identity
// models. No status field — "active" is simply expiresAt > now; there is no
// "claimed" state in 19B since claim isn't implemented yet (19C).
model GuestSellerSession {
  id        String            @id @default(cuid())
  tokenHash String            @unique
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     GuestSellerItem[]

  @@index([expiresAt])
}

// 19B: catalogModelId is REQUIRED (unlike a "pending recognition" design) —
// only an explicitly-confirmed CatalogModel is ever persisted. Recognition
// candidates live in client state only; nothing is written until the seller
// picks one. This keeps every row immediately claimable into MobileCaptureItem
// with no "what does an unresolved guest row mean" question for 19C. No PII
// field exists anywhere on this model by design.
model GuestSellerItem {
  id                 String             @id @default(cuid())
  sessionId          String
  session            GuestSellerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogModelId     String
  catalogModel       CatalogModel       @relation(fields: [catalogModelId], references: [id])
  quantity           Int                @default(1)
  condition          String?
  notes              String?
  saleTypePreference String?
  clientToken        String
  payloadFingerprint String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([sessionId, clientToken])
  @@unique([sessionId, catalogModelId])
  @@index([sessionId])
}

// 15F: versioned, effective-dated risk policy configuration. Plain integer
// cents/bps fields only (no JS float financial math) — see riskPolicy.ts for the
// pure evaluation engine that consumes a snapshot of "the" effective row. Effective
// version at a given instant = the row with the greatest effectiveFrom <= asOf
// (see getEffectiveRiskPolicy) — versions are never mutated after creation, only
// superseded by a newer version with a later effectiveFrom, so there is never an
// ambiguous "current" row for a given asOf.
model RiskPolicyConfig {
  id      String @id @default(cuid())
  version Int    @unique

  effectiveFrom DateTime

  highValueReviewThresholdCents      Int
  veryHighValueThresholdCents        Int
  payoutApprovalThresholdCents       Int
  priceDeviationToleranceBps         Int
  destructiveActionsRequireApproval  Boolean @default(true)
  commercialOverridesRequireApproval Boolean @default(true)

  notes     String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([effectiveFrom])
}

// 15F: a single narrow approval-gate record for one risky action instance. Not a
// generic BPM/workflow entity — targetType/targetId + contextFingerprint bind it to
// exactly one proposed change; a changed proposal invalidates the fingerprint match,
// so a stale approval can never authorize a different outcome (see riskApprovals.ts).
model RiskApprovalRequest {
  id            String @id @default(cuid())
  action        String
  status        String @default("pending") // pending|approved|rejected|cancelled|expired|consumed
  riskLevel     String // medium|high
  policyCode    String
  policyVersion Int

  targetType String
  targetId   String

  // Deterministic hash of (action, targetId, decisionContext) — see
  // computeContextFingerprint. Used both for pending-request dedup and to detect a
  // materially changed proposal before consumption (section 17/28).
  contextFingerprint String
  decisionContext    Json
  reasons            Json

  requestedBy String
  requestedAt DateTime @default(now())

  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  decisionNote String?

  expiresAt  DateTime?
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, riskLevel])
  @@index([action, targetId, contextFingerprint])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// 15K: versioned, effective-dated auto-listing policy — same discipline as 15F's
// RiskPolicyConfig above. Seeded disabled (see migration) so no deployment can
// suddenly start creating listings; an admin must explicitly publish an enabled
// version via /admin/auto-listing.
model AutoListingPolicyConfig {
  id      String @id @default(cuid())
  version Int    @unique

  effectiveFrom DateTime
  enabled       Boolean  @default(false)

  // 'medium' | 'high' — 14C confidence levels safe enough to auto-list from. 'low'
  // and 'insufficient' can never be stored here (see autoListingPolicy.ts validation).
  minimumPricingConfidence String
  // 0 = recommended low, 5000 = midpoint, 10000 = recommended high.
  pricePositionBps         Int

  notes     String?
  createdBy String
  createdAt DateTime @default(now())

  runs AutoListingRun[]

  @@index([effectiveFrom])
}

// 15K: one durable record per "Run Auto-Listing" click — bounded batch, resumable
// cursor into 15J's candidate scan. Never a background/scheduled job in 15K.
model AutoListingRun {
  id            String   @id @default(cuid())
  policyId      String
  policy        AutoListingPolicyConfig @relation(fields: [policyId], references: [id], onDelete: Restrict)
  policyVersion Int
  requestedBy   String
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  startCursor   String?
  nextCursor    String?
  sourceExhausted Boolean @default(false)

  attempts AutoListingAttempt[]

  @@index([startedAt])
}

// 15K: one row per physical item attempted within a run — the durable answer to
// "why was/wasn't this item listed automatically?" No buyer PII (item/pricing/risk
// facts only). unique(runId, itemId) is the idempotency backstop for Part S.
model AutoListingAttempt {
  id    String @id @default(cuid())
  runId String
  run   AutoListingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId String

  // listed | review_required | denied | already_listed | stale | failed
  outcome    String
  reasonCode String

  readinessSnapshot Json
  pricingSnapshot   Json?
  proposedPriceCents Int?
  riskSnapshot      Json?

  listingId String?
  createdAt DateTime @default(now())

  @@unique([runId, itemId])
  @@index([itemId])
  @@index([outcome])
  // 15K (execution-snapshot pass): supports the "latest actionable attempt per item"
  // DISTINCT ON query behind the Needs Manual Review predicate (autoListingReview.ts).
  @@index([itemId, createdAt])
}
