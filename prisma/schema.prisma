model SellerInboundShipment {
  id                 String           @id @default(cuid())
  sellerSubmissionId String
  sellerSubmission   SellerSubmission @relation(fields: [sellerSubmissionId], references: [id], onDelete: Restrict)
  intakeDraftId      String?
  intakeDraft        IntakeDraft?     @relation(fields: [intakeDraftId], references: [id], onDelete: SetNull)

  // 15B: denormalized from sellerSubmission.sellerPortfolioId at creation time so a
  // portfolio's shipments can be queried directly without joining through submission.
  sellerPortfolioId String?
  sellerPortfolio   SellerPortfolio? @relation(fields: [sellerPortfolioId], references: [id], onDelete: SetNull)

  status           String  @default("draft")
  carrier          String?
  trackingNumber   String?
  expectedQuantity Int
  receivedQuantity Int?

  shippedAt   DateTime?
  deliveredAt DateTime?
  receivedAt  DateTime?
  receivedBy  String?

  sellerNotes     String?
  adminNotes      String?
  conditionStatus String?
  issueSummary    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 15D: explicit intake lineage — drafts/items created by the bulk intake workbench
  // FROM this shipment. See IntakeDraft.sellerInboundShipmentId / ItemInstance.
  // sellerInboundShipmentId for the "distinct from intakeDraft above" note.
  intakeDraftLineage IntakeDraft[]           @relation("IntakeDraftLineageShipment")
  items              ItemInstance[]
  workbenchSession   IntakeWorkbenchSession?

  @@index([sellerSubmissionId])
  @@index([trackingNumber])
  @@index([status])
  @@index([receivedAt])
  @@index([sellerPortfolioId])
}

// 15D: lightweight DB-backed lease so two admins accidentally opening the same
// shipment's workbench get a visible "active elsewhere" signal. Informational only —
// actual duplicate-processing safety comes from IntakeDraft's workbenchClientToken
// unique constraint and the per-confirm transaction lock, not this lease. Expires and
// is renewable; takeover is always explicit (a new claim with `takeover: true`), never
// automatic, and a stale (expired) lease never permanently blocks work.
model IntakeWorkbenchSession {
  id                      String                @id @default(cuid())
  sellerInboundShipmentId String                @unique
  sellerInboundShipment   SellerInboundShipment @relation(fields: [sellerInboundShipmentId], references: [id], onDelete: Cascade)
  claimToken              String
  claimedAt               DateTime              @default(now())
  expiresAt               DateTime
  renewedAt               DateTime?
}

model SellerPricingPreference {
