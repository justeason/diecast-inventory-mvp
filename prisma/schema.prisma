  sessionId          String
  session            MobileCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogModelId     String
  catalog            CatalogModel         @relation(fields: [catalogModelId], references: [id])
  quantity           Int                  @default(1)
  acquisitionDate    DateTime?
  condition          String?
  notes              String?
