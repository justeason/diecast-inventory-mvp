generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CatalogModel {
  id                   String                      @id @default(cuid())
  brand                String
  name                 String
  series               String?
  year                 Int?
  color                String?
  scale                String?
  notes                String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  items                ItemInstance[]
  collectionItems      CollectionItem[]
  suggestionsApproved  CatalogSuggestion[]         @relation("SuggestionApproval")
  photos               CatalogModelPhoto[]
  sellerSubmissions    SellerSubmission[]
  wantedBy             WantedCatalogModel[]
  externalObservations ExternalMarketObservation[]
  photoFingerprints    CatalogPhotoFingerprint[]
  captureItems         MobileCaptureItem[]
  buyerAlertEvents     BuyerAlertEvent[]
  buyerAlertFanouts    BuyerAlertFanout[]
  intakeDrafts         IntakeDraft[]
  guestSellerItems     GuestSellerItem[]
  marketVariants       MarketVariant[]
  orderItems           OrderItem[]

  @@index([brand])
  @@index([name])
}

model MarketVariant {
  id             String       @id @default(cuid())
  catalogModelId String
  catalogModel   CatalogModel @relation(fields: [catalogModelId], references: [id], onDelete: Cascade)

  packagingType  String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          ItemInstance[]
  intakeDrafts   IntakeDraft[]
  observations   ExternalMarketObservation[]
  orderItems     OrderItem[]

  @@unique([catalogModelId, packagingType])
  @@index([catalogModelId])
}

model CatalogModelMergeAudit {
  id                      String   @id @default(cuid())
  // Stored as plain strings — not FK relations — so audit survives duplicate deletion.
  canonicalCatalogModelId String
  duplicateCatalogModelId String
  canonicalSnapshot       Json
  duplicateSnapshot       Json
  movedItemInstances      Int      @default(0)
  movedCollectionItems    Int      @default(0)
  movedSellerSubmissions  Int      @default(0)
  movedCatalogSuggestions Int      @default(0)
  movedPhotos             Int      @default(0)
  adminNote               String?
  mergedAt                DateTime @default(now())

  @@index([canonicalCatalogModelId])
  @@index([duplicateCatalogModelId])
}

model CatalogDuplicateSuppression {
  id        String   @id @default(cuid())
  // Stable pair key: smaller id + "|" + larger id (lexicographic). Unique per pair.
  pairKey   String   @unique
  adminNote String?
  createdAt DateTime @default(now())
}

model CatalogDataQualityAudit {
  id             String   @id @default(cuid())
  // Plain strings — not FK relations — so audit survives model changes/deletions.
  issueKey       String
  action         String
  catalogModelId String
  beforeSnapshot Json
  afterSnapshot  Json
  adminNote      String?
  createdAt      DateTime @default(now())

  @@index([catalogModelId])
  @@index([issueKey])
  @@index([createdAt])
}

model CatalogModelPhoto {
  id           String                    @id @default(cuid())
  catalogId    String
  catalog      CatalogModel              @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  sortOrder    Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  fingerprints CatalogPhotoFingerprint[]
}

model ItemInstance {
  id                      String                 @id @default(cuid())
  sku                     String                 @unique
  catalogId               String
  catalog                 CatalogModel           @relation(fields: [catalogId], references: [id])
  marketVariantId         String
  marketVariant           MarketVariant          @relation(fields: [marketVariantId], references: [id])
  locationId              String?
  location                StorageLocation?       @relation(fields: [locationId], references: [id])
  cardedOrLoose           String
  condition               String
  conditionNotes          String?
  purchasePrice           Float?
  listPrice               Float?
  status                  String                 @default("draft")
  notes                   String?
  sourceType              String?
  sellerAgreementId       String?
  sellerAgreement         SellerAgreement?       @relation(fields: [sellerAgreementId], references: [id], onDelete: SetNull)
  // 15B: explicit lineage back to the seller batch this item came from — set once at
  // intake conversion time from the accepted agreement's portfolio (never inferred
  // from SellerProfile alone). Null for company-owned items and legacy/pre-15B
  // consignment or buyout items — never backfilled by guessing.
  sellerPortfolioId       String?
  sellerPortfolio         SellerPortfolio?       @relation(fields: [sellerPortfolioId], references: [id], onDelete: SetNull)
  // 15D: explicit shipment lineage — copied exactly once from IntakeDraft.sellerInboundShipmentId
  // at conversion. Never inferred from timestamp/seller/quantity. Null for legacy/
  // manual/non-shipment items — those remain "Not captured" (see 15C
  // shipmentLineageAmbiguous), never backfilled by guessing.
  sellerInboundShipmentId String?
  sellerInboundShipment   SellerInboundShipment? @relation(fields: [sellerInboundShipmentId], references: [id], onDelete: SetNull)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  photos                  Photo[]
  listing                 Listing?
  orderItems              OrderItem[]
  intakeDraft             IntakeDraft?

  @@index([sellerAgreementId])
  @@index([sourceType])
  @@index([sellerPortfolioId])
  @@index([sellerInboundShipmentId])
  @@index([marketVariantId])
}

model Photo {
  id        String       @id @default(cuid())
  itemId    String
  item      ItemInstance @relation(fields: [itemId], references: [id])
  url       String
  type      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
}

model StorageLocation {
  id                  String                  @id @default(cuid())
  label               String
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  items               ItemInstance[]
  intakeDrafts        IntakeDraft[]           @relation("IntakeDraftLocation")
  defaultForShipments SellerInboundShipment[] @relation("ShipmentDefaultStorage")
}

model Listing {
  id          String       @id @default(cuid())
  itemId      String       @unique
  item        ItemInstance @relation(fields: [itemId], references: [id])
  price       Float
  title       String
  description String?
  status      String       @default("active")
  // Durable transition counter — incremented (not just updatedAt) whenever this
  // Listing goes through an alert-relevant mutation. Used as the version salt in
  // buyer-alert event keys, since updatedAt alone is not a safe uniqueness anchor
  // (millisecond precision, not guaranteed monotonic-unique under rapid writes).
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
}

model CustomerProfile {
  id                 String                    @id @default(cuid())
  email              String                    @unique
  name               String?
  phone              String?
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  orders             Order[]
  sessions           CustomerSession[]
  credential         CustomerCredential?
  sellerProfile      SellerProfile?
  collectionItems    CollectionItem[]
  catalogSuggestions CatalogSuggestion[]
  sellerSubmissions  SellerSubmission[]
  sellerPayoutLines  SellerPayoutLine[]
  sellerPayouts      SellerPayout[]
  communityProfile   CustomerCommunityProfile?
  wantedList         WantedCatalogModel[]
  captureSessions    MobileCaptureSession[]
  alertPreference    BuyerAlertPreference?
  alertEvents        BuyerAlertEvent[]
}

model SellerProfile {
  id                  String                     @id @default(cuid())
  profileId           String                     @unique
  profile             CustomerProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  displayName         String?
  status              String                     @default("pending")
  commissionRate      Float                      @default(0.20)
  payoutMethod        String?
  payoutHandle        String?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  agreements          SellerAgreement[]
  payouts             SellerPayout[]
  commissionOverrides SellerCommissionOverride[]
  portfolios          SellerPortfolio[]
}

// 15B: operational grouping/navigation layer for one seller consignment batch. Does
// NOT replace SellerSubmission/SellerAgreement/SellerInboundShipment/ItemInstance as
// the authoritative transactional records — those are unchanged and still hold their
// own state; a Portfolio just links them together for one commercial batch so the
// admin has a single page to work from. `status` is intentionally a small, coarse set
// — the detailed operational stage (awaiting_agreement/awaiting_shipment/inbound/
// intake/active) shown in the UI is DERIVED at read time from linked-record state
// (see derivePortfolioStage in sellerPortfolio.ts), never trusted from a stored value,
// so the displayed stage can never silently drift from underlying reality.
model SellerPortfolio {
  id              String        @id @default(cuid())
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  name   String?
  status String  @default("draft") // draft | open | completed | cancelled — see derivePortfolioStage for the full display stage

  // Admin-confirmed batch totals — expectedItemCount is informational (e.g. what the
  // seller said they'd ship); acceptedItemCount is the authoritative volume-tier
  // denominator source for a portfolio-linked SellerAgreement (see 15A
  // resolveCommissionTerms — signature unchanged, this just becomes the caller-
  // supplied acceptedItemCount for portfolio-linked agreements). Mutable until the
  // portfolio's current agreement is accepted, at which point the agreement's own
  // frozen acceptedItemCount snapshot (15A) is authoritative for that agreement
  // forever — later changes here can never re-tier a signed agreement.
  expectedItemCount Int?
  acceptedItemCount Int?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  submissions      SellerSubmission[]
  agreements       SellerAgreement[]
  inboundShipments SellerInboundShipment[]
  items            ItemInstance[]

  @@index([sellerProfileId])
  @@index([status])
}

// 15A: Commission Policy Engine — authoritative, versioned commission configuration.
// Policies are never mutated in place once used; a rate change is a new policy row
// with a later effectiveFrom (prospective only). Tiers are floor-only (minItems), so
// by construction there are no overlaps and no gaps: every item count >= the lowest
// tier's floor matches exactly one tier (the highest floor <= count); counts below
// the lowest floor use the policy default.
model CommissionPolicy {
  id     String @id @default(cuid())
  name   String
  status String @default("draft") // draft | active | ended

  effectiveFrom DateTime
  effectiveTo   DateTime?

  defaultCommissionBps Int // 0-10000 (basis points; 2000 = 20%)
  minimumFeeCents      Int // integer cents — exact, no JS Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers      CommissionTier[]
  agreements SellerAgreement[]

  @@index([status])
  @@index([effectiveFrom])
}

model CommissionTier {
  id       String           @id @default(cuid())
  policyId String
  policy   CommissionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  minItems        Int // inclusive lower bound; open-ended upper bound (next tier's minItems, or infinity)
  commissionBps   Int
  minimumFeeCents Int? // null = inherit policy default

  createdAt DateTime @default(now())

  agreements SellerAgreement[]

  @@unique([policyId, minItems])
  @@index([policyId])
}

// Exceptional, auditable per-seller override — bypasses tier/default resolution but
// is itself bypassed by an explicit agreement-level override. Policy-independent by
// design (directly sets bps/fee), so it survives across policy version changes.
model SellerCommissionOverride {
  id              String        @id @default(cuid())
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  commissionBps   Int?
  minimumFeeCents Int?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  reason    String
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerProfileId])
  @@index([effectiveFrom])
}

model CustomerLoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CustomerSession {
  id          String   @id @default(cuid())
  profileId   String
  sessionHash String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  // 19A: which credential proved identity for this session — 'magic_link' |
  // 'password'. Nullable so every pre-19A row (and any future auth method we
  // forget to stamp) reads as simply "unknown", never misread as a fresh
  // magic-link reauth — recentMagicLinkReauth() requires the literal string
  // 'magic_link', so null can never satisfy it.
  authMethod  String?

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
}

// 19A: password credential, deliberately a separate one-to-one model rather than
// a field on CustomerProfile — CustomerProfile is read broadly and often without
// an explicit `select` (e.g. sellerProfiles.ts's existence check), so a hash
// living there would be one missed `select` away from leaking into memory by
// default. Keeping it here means passwordHash is only ever fetched by code that
// explicitly joins/queries this model.
model CustomerCredential {
  id           String          @id @default(cuid())
  profileId    String          @unique
  profile      CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  passwordHash String

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model CustomerCommunityProfile {
  id                 String          @id @default(cuid())
  profileId          String          @unique
  profile            CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  handle             String          @unique
  displayName        String
  bio                String?
  isPublic           Boolean         @default(false)
  showOnLeaderboards Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([isPublic, showOnLeaderboards])
  @@index([handle])
}

model Order {
  id                     String           @id @default(cuid())
  buyerName              String
  buyerEmail             String
  buyerPhone             String?
  status                 String           @default("pending")
  notes                  String?
  estimatedShipping      Float?
  adminNotes             String?
  followUpNotes          String?
  paymentStatus          String           @default("unpaid")
  paymentMethod          String?
  paymentReference       String?
  paymentLink            String?
  paymentRequestedAt     DateTime?
  paidAt                 DateTime?
  completedAt            DateTime?
  stripeSessionId        String?
  stripeSessionExpiresAt DateTime?
  stripePaymentIntentId  String?
  // 39B: durable reservation deadline. Set to now+30min at createOrder (protects
  // the pre-Stripe-session interval); updated to the Stripe Checkout Session's own
  // authoritative expires_at once a session is created. Null only for legacy
  // pre-39B orders — never blindly expired (see orderReservation.ts).
  reservationExpiresAt   DateTime?
  customerProfileId      String?
  customerProfile        CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  orderItems             OrderItem[]
}

model OrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  itemId    String
  item      ItemInstance @relation(fields: [itemId], references: [id])
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id])
  price     Float
  createdAt DateTime     @default(now())

  // 21B: mutable identity pointers — a later admin CatalogModel merge MAY
  // re-point these. Never re-derive from the current ItemInstance after creation.
  catalogModelId  String?
  catalogModel    CatalogModel?  @relation(fields: [catalogModelId], references: [id])
  marketVariantId String?
  marketVariant   MarketVariant? @relation(fields: [marketVariantId], references: [id])

  // 21B: immutable sale-time physical facts, captured once from the authoritative
  // ItemInstance at order-item creation. Never rewritten by merge/correction logic —
  // silent physical-fact drift is not allowed, only deliberate identity re-pointing.
  snapshotPackagingType String?
  snapshotCondition     String?

  // 21C: where the physical-fact snapshot above came from — 'sale_time'
  // (captured live from the authoritative ItemInstance at creation),
  // 'intake_declared' (reconstructed from the immutable converted IntakeDraft
  // for a legacy sale — proves intake-time declared state, not zero drift
  // since), or 'legacy_model_only' (legacy sale with trustworthy catalogModelId/
  // price/soldAt but no recoverable packaging/condition evidence). Null means
  // not yet normalized. Never a confidence score — answers "where," not "how sure."
  snapshotProvenance String?

  sellerPayoutLine SellerPayoutLine?

  @@index([catalogModelId])
  @@index([marketVariantId])
}

model CollectionItem {
  id        String          @id @default(cuid())
  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  catalogId String?
  catalog   CatalogModel? @relation(fields: [catalogId], references: [id])

  brand          String?
  name           String?
  series         String?
  year           Int?
  color          String?
  scale          String?
  cardedOrLoose  String?
  condition      String?
  conditionNotes String?
  quantity       Int     @default(1)

  purchasePrice Float?
  purchaseDate  DateTime?
  notes         String?
  isPublic      Boolean   @default(false)

  aiExtractionConfidence Float?
  aiExtractionNotes      String?
  aiExtractedAt          DateTime?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  photos             CollectionItemPhoto[]
  catalogSuggestions CatalogSuggestion[]
  sellerSubmissions  SellerSubmission[]

  // 26B: CollectionItem is the required, durable ownership-ledger identity —
  // every AcquisitionLot/CollectionDisposal belongs to exactly one CollectionItem
  // (never optional/informational), which is why hard-delete is now Restrict-
  // guarded once ledger rows exist (see AcquisitionLot/CollectionDisposal below).
  acquisitionLots AcquisitionLot[]
  disposals       CollectionDisposal[]

  // 16F Final: DB-enforced "one catalog-linked CollectionItem per customer" —
  // closes the createCollectionItem check-then-create race (concurrent Add to
  // Collection from /browse could otherwise create two rows for the same model).
  // Postgres treats NULL as distinct from any other NULL in a unique index, so
  // freeform (catalogId=null) rows remain unlimited per customer, unaffected.
  @@unique([profileId, catalogId])
}

model CollectionItemPhoto {
  id     String         @id @default(cuid())
  itemId String
  item   CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  url       String
  type      String @default("other")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
}

// 26B: ownership ledger — durable acquisition/disposal history for private
// Collection holdings, enabling multi-lot cost tracking and Recorded Realized
// Gain/Loss. CollectionItem is the required identity anchor (26A follow-up) —
// never profileId/catalogId directly — so a ledgered CollectionItem can never
// be hard-deleted out from under its own history (onDelete: Restrict).
model AcquisitionLot {
  id               String         @id @default(cuid())
  collectionItemId String
  collectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Restrict)

  quantityAcquired  Int
  remainingQuantity Int

  // Known per-unit cost, integer cents. Null unless costKnowledge='known'.
  unitRecordedCostCents Int?

  // Preserves the raw legacy CollectionItem.purchasePrice (converted to cents)
  // when quantity>1 made its per-unit-vs-total meaning ambiguous at backfill
  // time. Audit/display only — NEVER read by cost/gain math.
  legacyRecordedPriceCents Int?

  // 'known' | 'ambiguous_legacy' | 'unknown'
  costKnowledge String

  // Customer-claimed acquisition date — nullable, never fabricated.
  acquiredAt DateTime?
  // Earliest point the ledger itself can assert ownership was true — required,
  // never null. Migration cutover timestamp for legacy_backfill lots (identical
  // across the whole backfill run), else the lot's own createdAt. FIFO/history
  // ordering uses COALESCE(acquiredAt, ledgerEffectiveAt), never a fabricated date.
  ledgerEffectiveAt DateTime

  // 'manual' | 'i_own_it' | 'quick_capture' | 'legacy_backfill' | 'correction'
  source String

  // Durable idempotency for upstream-fact-triggered lots (currently only legacy
  // backfill: 'legacy-backfill:<collectionItemId>'). Null for ordinary manual lots.
  sourceKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations CollectionDisposalAllocation[]

  @@index([collectionItemId])
}

// 'platform_sale' | 'external_sale' | 'gift' | 'trade' | 'other_removal' | 'correction'
// platform_sale covers BOTH a completed consignment sale AND a buyout
// ownership transfer — sourceKey's prefix distinguishes the trigger, since
// calling buyout a "marketplace sale" would misdescribe it (26A follow-up §15).
model CollectionDisposal {
  id               String         @id @default(cuid())
  collectionItemId String
  collectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Restrict)

  quantity     Int
  disposalType String
  disposedAt   DateTime

  grossProceedsCents Int?
  netProceedsCents   Int?

  // Durable idempotency: 'orderitem:<orderItemId>' (consignment platform sale),
  // 'buyout-conversion:<itemInstanceId>' (buyout), 'manual:<token>' (manual
  // disposal double-submit guard). Null for corrections with no upstream fact.
  sourceKey String? @unique

  // Reversal, never deletion — historical facts are never destroyed.
  reversedAt     DateTime?
  reversalReason String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations CollectionDisposalAllocation[]

  @@index([collectionItemId])
  @@index([disposalType])
}

model CollectionDisposalAllocation {
  id                String             @id @default(cuid())
  disposalId        String
  // Restrict, not Cascade: a CollectionDisposal is never hard-deleted by any
  // business path (reversal only sets reversedAt) — Restrict on BOTH
  // allocation parents makes that invariant DB-enforced, not just app-level,
  // so allocation rows can never silently disappear via a parent delete.
  disposal          CollectionDisposal @relation(fields: [disposalId], references: [id], onDelete: Restrict)
  acquisitionLotId  String
  acquisitionLot    AcquisitionLot     @relation(fields: [acquisitionLotId], references: [id], onDelete: Restrict)

  quantity Int
  // Snapshot at disposal time — unitRecordedCostCents * quantity for a
  // known-cost lot, else null. Never recomputed from later lot edits (26A
  // follow-up §17) — historical realized calculations must not silently change.
  allocatedRecordedCostCents Int?

  createdAt DateTime @default(now())

  @@index([disposalId])
  @@index([acquisitionLotId])
}

model CatalogSuggestion {
  id String @id @default(cuid())

  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  collectionItemId String?
  collectionItem   CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)

  brand  String
  name   String
  series String?
  year   Int?
  color  String?
  scale  String?

  userNotes  String?
  adminNotes String?

  aiExtractionConfidence Float?

  status String @default("pending")

  reviewedAt        DateTime?
  approvedCatalogId String?
  approvedCatalog   CatalogModel? @relation("SuggestionApproval", fields: [approvedCatalogId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerSubmission {
  id        String          @id @default(cuid())
  profileId String
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  collectionItemId String?
  collectionItem   CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)

  catalogId String?
  catalog   CatalogModel? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  brand          String?
  name           String?
  series         String?
  year           Int?
  color          String?
  scale          String?
  cardedOrLoose  String?
  condition      String?
  conditionNotes String?
  quantity       Int     @default(1)

  saleTypePreference String?
  expectedPrice      Float?
  userNotes          String?

  userMessage String?
  adminNotes  String?

  status     String    @default("submitted")
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 15B: one portfolio may group several submissions (e.g. seller adds more items
  // before the agreement is finalized). Null = not yet assigned to a portfolio, or a
  // legacy pre-15B submission — never inferred from seller identity alone.
  sellerPortfolioId String?
  sellerPortfolio   SellerPortfolio? @relation(fields: [sellerPortfolioId], references: [id], onDelete: SetNull)

  photos           SellerSubmissionPhoto[]
  intakeDrafts     IntakeDraft[]
  agreements       SellerAgreement[]
  inboundShipments SellerInboundShipment[]

  lifecycleEvents   SellerLifecycleEvent[]
  lifecycleCases    SellerLifecycleCase[]
  pricingPreference SellerPricingPreference?

  @@index([profileId])
  @@index([status])
  @@index([collectionItemId])
  @@index([sellerPortfolioId])
}

model SellerSubmissionPhoto {
  id           String           @id @default(cuid())
  submissionId String
  submission   SellerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
}

model IntakeDraft {
  id     String @id @default(cuid())
  status String @default("draft")

  frontPhotoUrl String?
  backPhotoUrl  String?

  brand           String?
  name            String?
  year            Int?
  series          String?
  color           String?
  scale           String?
  cardedOrLoose   String?
  condition       String?
  conditionNotes  String?
  listPrice       Float?
  storageLocation String?
  notes           String?

  expectedQuantity Int?
  receivedQuantity Int?
  receivedAt       DateTime?
  receivedBy       String?
  receivingNotes   String?

  storageLocationId String?
  intakeLocation    StorageLocation? @relation("IntakeDraftLocation", fields: [storageLocationId], references: [id], onDelete: SetNull)

  convertedItemId  String?                 @unique
  convertedItem    ItemInstance?           @relation(fields: [convertedItemId], references: [id])
  inboundShipments SellerInboundShipment[]

  aiExtractionRaw        String?
  aiExtractionNotes      String?
  aiExtractionConfidence Float?

  sellerSubmissionId String?
  sellerSubmission   SellerSubmission? @relation(fields: [sellerSubmissionId], references: [id], onDelete: SetNull)

  // 15D: direct catalog resolution — set when a workbench (or future) intake flow
  // already resolved an exact CatalogModel (smart search / image match / manual
  // selection), so conversion never has to re-derive it by fuzzy brand/name matching.
  // Null for legacy drafts, which keep using the existing string-field matching in
  // convertDraft.
  catalogModelId String?
  catalogModel   CatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull)

  // 21B: nullable — legitimately unknown pre-classification (catalogModelId and/or
  // cardedOrLoose not yet known). Auto-resolved server-side whenever both become
  // known; cleared to null whenever either becomes unknown again. Never a client-
  // supplied value, never an "Unspecified" placeholder.
  marketVariantId String?
  marketVariant   MarketVariant? @relation(fields: [marketVariantId], references: [id], onDelete: SetNull)

  // 15D: explicit shipment lineage — the exact SellerInboundShipment this physical
  // item's workbench intake was started from. Set once when the workbench creates the
  // draft; never inferred from timestamp/seller/quantity. Null for legacy/manual/
  // non-shipment intake. Distinct from `inboundShipments` above (the reverse relation
  // recording which draft captured a shipment's admin RECEIVING action, an unrelated
  // pre-15D concept).
  sellerInboundShipmentId String?
  sellerInboundShipment   SellerInboundShipment? @relation("IntakeDraftLineageShipment", fields: [sellerInboundShipmentId], references: [id], onDelete: SetNull)

  // 15D: idempotency key for one workbench "Confirm & Next" action (one physical
  // unit). Unique per shipment so double-click/Enter-twice/network retry can never
  // create a second draft/ItemInstance for the same physical scan. Null for legacy/
  // non-workbench drafts.
  workbenchClientToken String?

  // 15D: exception hand-off signal (feeds 15E) — LIVE/CURRENT state. Set when a
  // workbench-created draft could not be safely auto-converted (unknown model,
  // invalid storage, overage, missing condition). The draft stays unresolved (status
  // remains 'draft', never silently converted or discarded) so the admin can continue
  // to the next physical item without the whole shipment stopping. During 15E
  // resolution this MAY change as a fix reveals a different blocking issue (e.g.
  // unknown_model -> missing_condition) — these two fields always reflect the CURRENT
  // blocker, never the original one (see initialException* below for that).
  workbenchExceptionCode String?
  workbenchExceptionNote String?

  // 15E-review (evidence pass): IMMUTABLE first-detection evidence. Written exactly
  // once, at the moment a draft FIRST becomes an exception (workbenchExceptionCode
  // transitions from null to non-null) — never changed afterward, even as the live
  // fields above evolve through subsequent resolution attempts or eventually clear
  // into a successful conversion. This is what makes "why did this physical item
  // originally enter the queue" permanently recoverable regardless of how its
  // classification changed since. Never used to decide queue membership (see
  // openIntakeExceptionWhere in intakeExceptions.ts, which uses only the live/current
  // state) — only for audit/detail display.
  initialExceptionCode String?
  initialExceptionNote String?
  initialExceptionAt   DateTime?

  rejectedAt            DateTime?
  rejectionReason       String?
  sellerRejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerInboundShipmentId, workbenchClientToken])
  @@index([sellerSubmissionId])
  @@index([storageLocationId])
  @@index([catalogModelId])
  // 15E: the exception queue's primary filter (open exceptions) + default sort
  // (oldest first) — see intakeExceptions.ts openIntakeExceptionWhere().
  @@index([workbenchExceptionCode, createdAt])
}

model SellerAgreement {
  id           String           @id @default(cuid())
  submissionId String
  submission   SellerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  sellerProfileId String?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)

  // 15B: set when this agreement is the (or a historical) commercial agreement for a
  // portfolio batch spanning possibly multiple submissions. submissionId above stays
  // the required technical anchor (the schema still needs exactly one SellerSubmission
  // per agreement); for a portfolio-linked agreement, treat submissionId as the
  // portfolio's PRIMARY submission and sellerPortfolioId as the true commercial scope.
  sellerPortfolioId String?
  sellerPortfolio   SellerPortfolio? @relation(fields: [sellerPortfolioId], references: [id], onDelete: SetNull)

  type     String
  currency String @default("USD")
  status   String @default("draft")

  agreedBuyoutAmount  Decimal? @db.Decimal(10, 2)
  commissionPercent   Decimal? @db.Decimal(6, 4)
  fixedFee            Decimal? @db.Decimal(10, 2)
  minimumSellerPayout Decimal? @db.Decimal(10, 2)
  agreedListPrice     Decimal? @db.Decimal(10, 2)

  // 15A: Commission Policy Engine snapshot. Resolved once (draft/proposed: live
  // preview, recomputed on each edit; locked permanently at acceptance) — never
  // re-derived by payout calculation. Null on every field = legacy agreement that
  // predates this feature; its commissionPercent/fixedFee/minimumSellerPayout above
  // were set manually and are preserved exactly as-is, never backfilled.
  commissionMinimumFee     Decimal?          @db.Decimal(10, 2) // minimum commission floor per item — distinct from minimumSellerPayout (which floors seller's net, not the fee)
  commissionPolicyId       String?
  commissionPolicy         CommissionPolicy? @relation(fields: [commissionPolicyId], references: [id], onDelete: SetNull)
  commissionTierId         String?
  commissionTier           CommissionTier?   @relation(fields: [commissionTierId], references: [id], onDelete: SetNull)
  commissionSource         String? // 'policy_default' | 'policy_tier' | 'seller_override' | 'agreement_override' (null = legacy)
  // Authoritative volume-tier denominator for THIS agreement — distinct from
  // SellerSubmission.quantity (seller-requested, not admin-accepted). Defaults from
  // submission.quantity at draft creation but is independently admin-editable/
  // confirmable up to that point; capped at submission.quantity (cannot accept more
  // than was submitted). Mutable while draft/proposed (drives the live preview);
  // frozen the instant status becomes 'accepted' — no code path writes it afterward,
  // so later submission-quantity edits or additional intake conversions can never
  // silently re-tier a signed agreement.
  acceptedItemCount        Int?
  commissionResolvedAt     DateTime?
  commissionExplanation    String?
  commissionOverrideReason String? // required when commissionSource = 'agreement_override'

  sellerTermsSummary String?
  adminNotes         String?

  items       ItemInstance[]
  payoutLines SellerPayoutLine[]

  proposedAt       DateTime?
  acceptedAt       DateTime?
  acceptanceMethod String?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([sellerProfileId])
  @@index([status])
  @@index([sellerPortfolioId])
}

